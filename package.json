{
  "name": "entry-pass",
  "version": "0.2.0",
  "description": "자재센터 출입차량 안전수칙 확인 및 사전 출입승인 앱 (Cloudflare Workers + D1 + R2)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute entry-pass-db --file schema.sql",
    "db:init:local": "wrangler d1 execute entry-pass-db --local --file schema.sql"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}
